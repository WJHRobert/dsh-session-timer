{
  "name": "dsh-session-timer",
  "version": "0.1.0",
  "description": "Minimal DSH plugin: log one duration/token line at the end of every turn.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "tokens",
    "timer"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJHRobert/dsh-session-timer.git"
  },
  "bugs": {
    "url": "https://github.com/WJHRobert/dsh-session-timer/issues"
  },
  "homepage": "https://github.com/WJHRobert/dsh-session-timer#readme",
  "license": "MIT"
}
